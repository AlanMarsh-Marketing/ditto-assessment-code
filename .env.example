# Copy to .env and fill in — never commit the real values (.env is gitignored).

# Notion internal integration token (Notion → Settings → Connections →
# Develop or manage integrations → your integration → "Internal Integration Secret").
NOTION_TOKEN=

# The id of the private Notion page you created (e.g. "Ditto Assessments")
# and shared with that integration. Accepts the plain id from the page's
# URL (the 32-character string, dashes optional).
NOTION_PARENT_PAGE_ID=

# Printed by `npm run setup:notion` the first time it runs — paste both in,
# then re-run the script any time to confirm it's idempotent (it reports
# these same ids rather than creating duplicates).
NOTION_RESPONSES_DB_ID=
NOTION_ANSWERS_DB_ID=
